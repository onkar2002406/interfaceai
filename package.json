{
  "name": "computer-use-automation-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Record-once / replay-many computer-use automation for legacy back-office applications.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "tsx src/cli/index.ts app",
    "discover": "tsx src/cli/index.ts discover",
    "replay": "tsx src/cli/index.ts replay",
    "catalog": "tsx src/cli/index.ts catalog",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "panel": "npm run build:ui && tsx src/cli/index.ts panel",
    "meridian": "npm run build:ui && tsx src/cli/index.ts panel --profile config/apps/meridian-core.yaml --port 4300 --operator-port 4101",
    "handoff": "tsx scripts/demo-human-handoff.ts",
    "evidence": "tsx scripts/capture-evidence.ts",
    "evidence:meridian": "tsx scripts/capture-meridian-evidence.ts",
    "probe": "tsx scripts/probe-target.ts",
    "pdf": "tsx scripts/render-pdf.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongodb": "^7.6.0",
    "openai": "^4.77.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "marked": "^18.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
