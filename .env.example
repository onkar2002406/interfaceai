# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.
#
# Only the DISCOVERY path needs a model. Deterministic replay, the safety
# guardrails, the human handoff and the whole test suite run with no key at all.

# ---------------------------------------------------------------------------
# Language model provider
#
# Discovery uses whichever key is present, in the order below. Setting one is
# enough; setting BOTH turns the second into an automatic fallback.
#
# Groq's free tier allows 8,000 tokens per minute on the models that support
# tool calling, and one discovery run spends 7k-31k prompt tokens across 4-10
# calls. So a run can start fine and take a 429 partway through. When an OpenAI
# key is also set, the run moves onto it and finishes instead of dying — the
# switch is announced on the console and recorded as a
# `model_provider_switched` event in the run's evidence.
#
# The daily ceiling is the one to plan around: 200,000 tokens per day on
# gpt-oss-120b, which at ~17k per run is roughly ELEVEN discovery runs a day.
# Budget accordingly before a demo. Replay uses no tokens at all, so only
# discovery and the chat front door draw on this. CODEBASE.md section 7 has the
# measured per-capability costs and the per-provider comparison.
#
# Override explicitly with `--provider groq|openai|scripted`, which pins one
# provider and disables the fallback.
# ---------------------------------------------------------------------------

# Groq — has a free tier, which is why it is tried first.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Needs tool calling. Groq's free tier has no vision model that also supports
# tools, and discovery does not need one: the model acts on a text inventory of
# what is on screen, and screenshots are recorded as evidence either way.
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI — the fallback when Groq rate-limits, errors, or keeps answering in
# prose instead of calling a tool. Requires a funded account; a valid key on an
# account with no credit returns 429 insufficient_quota, which is a billing
# state rather than a rate limit and is reported as such.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Force a provider regardless of which keys are present.
# LLM_PROVIDER=scripted

# ---------------------------------------------------------------------------
# Target application
#
# Operator credentials for the bundled demo app. Not secrets in any meaningful
# sense — the app prints them on its own sign-on page and only ever runs on
# localhost — but they live here rather than in a capability artifact or the
# product profile, because that is where real credentials would have to live.
# Capabilities declare "I need an authenticated session"; the runtime supplies
# the identity.
# ---------------------------------------------------------------------------
# The reference install (localhost:4000), and the default for any tenant that
# does not name its own pair.
COREBANK_OPERATOR=svc.demo
COREBANK_PASSWORD=demo1234

# Each institution runs its own staff directory, so each has its own operator.
# The tenant entries in config/apps/corebank-servicing.yaml name these variables;
# only the names are committed, never the values.
COREBANK_OPERATOR_FIRSTVALLEY=svc.fvcu
COREBANK_PASSWORD_FIRSTVALLEY=valley4321
COREBANK_OPERATOR_HARBORCU=svc.harbor
COREBANK_PASSWORD_HARBORCU=harbor8765

# ---------------------------------------------------------------------------
# MERIDIAN CORE — the hosted target at web-sample.interface-hiring.com
#
# Two OPERATOR IDENTITIES rather than two tenants: same institution, same base
# URL, different entitlements. Place Account Hold is supervisor-only, so the
# same capability has to be runnable as either and return the application's own
# answer about entitlement in each case.
#
# config/apps/meridian-core.yaml names these variables; only the names are
# committed. These particular values are demo credentials the application prints
# on its own sign-on page — but they live here, not in the profile, because that
# is where real ones would have to live.
# ---------------------------------------------------------------------------
MERIDIAN_TELLER_OPERATOR=teller1
MERIDIAN_TELLER_PASSWORD=password
MERIDIAN_SUPERVISOR_OPERATOR=super1
MERIDIAN_SUPERVISOR_PASSWORD=password

# ---------------------------------------------------------------------------
# Ports
#
# The control panel serves the React front end, the agent-facing capability API
# and the chat endpoint. The operator console is the standalone door onto a
# parked session; the panel also serves that same transport on its own origin,
# so the chat's escalation modal does not need a second one.
#
# Note these are OUR services. A locally-hosted MERIDIAN would need ports of its
# own AND its origin added to config/policy.meridian.json — pointing the agent
# at a new target is a policy change, not a flag.
# ---------------------------------------------------------------------------
PANEL_PORT=4200
OPERATOR_PORT=4100

# ---------------------------------------------------------------------------
# Run store (optional)
#
# Three things used to live only in RAM and vanish on restart: the run
# registry, the escalation queue, and the audit trail of explicit irreversible
# authorisations. The last of those is the one that matters — a record of who
# approved a posted transfer should not disappear when a process recycles.
#
# Leave unset and everything keeps its previous in-memory behaviour, so the
# repo still runs with nothing installed. Set it and those three become
# durable. `GET /api/health` reports which backend is live.
#
#   docker run -d -p 27017:27017 --name mongo mongo:7
#
# `docker compose up` runs one for you as the `mongo` service and points the
# app containers at it, overriding whatever is set here. The line above is for
# running Mongo in Docker but the app on the host. See DOCKER.md.
#
# Note what does NOT move here, deliberately: capability artifacts stay in git
# (human approval is the gate, so their home is where code review happens) and
# evidence stays on the filesystem (append-only, screenshots — that belongs in
# object storage, not a document database).
# ---------------------------------------------------------------------------
# MONGODB_URI=mongodb://localhost:27017/interface
# MONGODB_DB=interface

# ---------------------------------------------------------------------------
# Run behaviour
# ---------------------------------------------------------------------------
# Show the browser window. Useful when demoing the human handoff.
HEADFUL=0

# Salt for hashing PII in logs so events correlate within a run. Leave unset to
# generate a fresh random salt per run — safer, because logs from two runs then
# cannot be cross-referenced to confirm a value.
# REDACTION_SALT=
