# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.

# ---- LLM access (required only for the DISCOVERY path; replay never needs it) ----
OPENAI_API_KEY=sk-...
# Vision-capable model used for the observe -> decide -> act loop.
OPENAI_MODEL=gpt-4o

# Use the deterministic recorded-fixture provider instead of a live LLM.
# Lets the whole discovery pipeline run offline, with no key and no cost.
# LLM_PROVIDER=mock

# ---- Local target app ----
# Operator credentials for the bundled demo app. These are not secrets in any
# meaningful sense — the demo app prints them on its own sign-on page and it
# only ever runs on localhost — but they live here rather than in a capability
# artifact or the app profile, because that is where real credentials would have
# to live. Capabilities declare "I need an authenticated session"; the runtime
# supplies the identity.
COREBANK_OPERATOR=svc.demo
COREBANK_PASSWORD=demo1234

# ---- Operator console (human-in-the-loop) ----
OPERATOR_PORT=4100

# ---- Run behaviour ----
# Show the browser window. Useful when demoing the human handoff.
HEADFUL=0
# Salt for hashing PII in logs so events correlate without leaking values.
# Leave unset to generate a fresh random salt per run (safer, non-correlatable across runs).
# REDACTION_SALT=
